[
	object,
	uuid(5474df26-b4ed-4210-b6c9-e3bc62900041),
	dual,
	nonextensible,
	pointer_default(unique)
]
interface IMyMath50322 : IDispatch
{
	[id(1), helpstring("сложение")] 
		HRESULT Add([in] LONG x, [in] LONG y, [out, retval] LONG* z);
	[id(2), helpstring("вычитание")] 
		HRESULT Sub([in] LONG x, [in] LONG y, [out, retval] LONG* z);
	[id(3), helpstring("умножение")]
		HRESULT Mul([in] LONG x, [in] LONG y, [out, retval] LONG* z);

	[propget, id(4), helpstring("Параметр 1")] HRESULT Param1([out, retval] LONG* pVal);
	[propput, id(4), helpstring("Параметр 1")] HRESULT Param1([in] LONG newVal);
};



